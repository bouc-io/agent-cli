    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "prettier": "^3.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Elastic-2.0",
  "repository": {
