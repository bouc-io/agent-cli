{
  "name": "@bouc.io/agent-cli",
  "version": "1.0.0",
  "description": "Terminal-based CLI client for the bouc.io AI assistant platform",
  "type": "module",
  "bin": {
    "agent-cli": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "eventsource": "^3.0.2",
    "fast-glob": "^3.3.3",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "marked": "^12.0.0",
    "marked-terminal": "^7.1.0",
    "open": "^10.1.0",
